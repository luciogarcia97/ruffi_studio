# Copiá este archivo como .env y completá los valores.
# .env no se sube al repositorio.

# MySQL de desarrollo (docker-compose.yml y la API)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3316
MYSQL_DATABASE=ruffi
MYSQL_USER=ruffi
MYSQL_PASSWORD=cambiar-por-una-clave
MYSQL_ROOT_PASSWORD=cambiar-por-otra-clave

# En un servidor se puede pasar la conexión completa, que tiene prioridad:
# ConnectionStrings__Ruffi=Server=...;Port=3306;Database=ruffi;User ID=...;Password=...
